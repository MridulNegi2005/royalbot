# Copy this file to .env and fill in the real values. Never commit .env.

# Discord
DISCORD_BOT_TOKEN=
DISCORD_MODMAIL_TOKEN=

# Postgres. Keep the database in the same region as the bot: a cross-region
# host adds its full round trip to every query.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Lavalink. LAVALINK_PASSWORD must match lavalink.server.password in
# lavalink/application.yml, or the node refuses the connection.
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=

# Lavalink source plugins
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Google Programmable Search, used by /search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Other services
OPENWEATHER_API_KEY=
YOUTUBE_API_KEY=
BRAWL_STARS_API_TOKEN=
FIREBASE_CREDENTIALS_PATH=cogs/firestore.json

# Only used by cogs that main.py does not load
MYSQL_HOST=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
HEROKU_API_KEY=
HEROKU_POSTGRES_URI=
